# 관리자(/admin) 로그인·발행 기능에 필요한 환경변수.
# Vercel 대시보드(Production + Preview)에 각각 등록해야 실제로 동작합니다.

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 클라이언트 ID(웹 애플리케이션)
# 승인된 리디렉션 URI: https://<배포 도메인>/api/auth/callback/google (로컬 개발 시 http://localhost:3000/api/auth/callback/google 도 추가)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 로그인 세션 암호화용 랜덤 문자열. 터미널에서 `openssl rand -base64 32`로 생성.
AUTH_SECRET=

# 로그인을 허용할 유일한 Google 계정 이메일.
ADMIN_EMAIL=juun5005@gmail.com

# GitHub Fine-grained Personal Access Token.
# 발급: GitHub > Settings > Developer settings > Fine-grained tokens > Generate new token
# Repository access: jihunx-collab/asset-log 저장소 1개로만 제한
# Permissions: Contents = Read and write
GH_TOKEN=
GH_REPO=jihunx-collab/asset-log

# 배포 도메인 (예: https://asset-log-blue.vercel.app). 로컬 개발 시 http://localhost:3000
AUTH_URL=
